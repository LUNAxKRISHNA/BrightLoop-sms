generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model customer_accounts {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String          @unique @db.Uuid
  company_name    String          @db.VarChar(255)
  billing_address String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  phone           String?         @db.VarChar(30)
  city            String?         @db.VarChar(100)
  state           String?         @db.VarChar(100)
  postal_code     String?         @db.VarChar(20)
  gstin           String?         @db.VarChar(15)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices        invoices[]
  subscriptions   subscriptions[]
}

model discount_products {
  discount_id String    @db.Uuid
  product_id  String    @db.Uuid
  discounts   discounts @relation(fields: [discount_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([discount_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model discounts {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @db.VarChar(255)
  discount_type       discount_type
  discount_value      Decimal              @db.Decimal(12, 2)
  applies_to          discount_target
  min_purchase_amount Decimal              @default(0.00) @db.Decimal(12, 2)
  min_quantity        Int                  @default(1)
  start_date          DateTime             @db.Date
  end_date            DateTime?            @db.Date
  max_uses            Int?
  current_uses        Int                  @default(0)
  created_by          String               @db.Uuid
  discount_products   discount_products[]
  users               users                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscription_lines  subscription_lines[]
  subscriptions       subscriptions[]
}

model invoice_lines {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id           String              @db.Uuid
  subscription_line_id String?             @db.Uuid
  product_id           String              @db.Uuid
  description          String              @db.VarChar(255)
  quantity             Int
  unit_price           Decimal             @db.Decimal(12, 2)
  discount_amount      Decimal             @default(0.00) @db.Decimal(12, 2)
  tax_amount           Decimal             @default(0.00) @db.Decimal(12, 2)
  line_total           Decimal             @db.Decimal(12, 2)
  invoices             invoices            @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products             products            @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  subscription_lines   subscription_lines? @relation(fields: [subscription_line_id], references: [id], onUpdate: NoAction)
}

model invoices {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_number       String            @unique @db.VarChar(50)
  subscription_id      String            @db.Uuid
  customer_id          String            @db.Uuid
  status               invoice_status    @default(DRAFT)
  billing_period_start DateTime          @db.Date
  billing_period_end   DateTime          @db.Date
  issue_date           DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date             DateTime          @db.Date
  subtotal             Decimal           @db.Decimal(12, 2)
  discount_total       Decimal           @default(0.00) @db.Decimal(12, 2)
  tax_total            Decimal           @default(0.00) @db.Decimal(12, 2)
  total_amount         Decimal           @db.Decimal(12, 2)
  amount_paid          Decimal           @default(0.00) @db.Decimal(12, 2)
  is_sent              Boolean           @default(false)
  invoice_lines        invoice_lines[]
  customer_accounts    customer_accounts @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  subscriptions        subscriptions     @relation(fields: [subscription_id], references: [id], onUpdate: NoAction)
  payments             payments[]

  @@index([customer_id, status, due_date], map: "idx_inv_customer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id     String         @db.Uuid
  payment_method payment_method
  amount         Decimal        @db.Decimal(12, 2)
  payment_date   DateTime       @db.Date
  notes          String?
  recorded_by    String?        @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  invoices       invoices       @relation(fields: [invoice_id], references: [id], onUpdate: NoAction)
  users          users?         @relation(fields: [recorded_by], references: [id], onUpdate: NoAction)

  @@index([payment_date, amount], map: "idx_payments_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model plans {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(255)
  base_price          Decimal               @default(0.00) @db.Decimal(12, 2)
  billing_interval    billing_interval
  min_quantity        Int                   @default(1)
  available_from      DateTime              @db.Date
  available_to        DateTime?             @db.Date
  auto_close_at_end   Boolean               @default(false)
  can_close_early     Boolean               @default(false)
  can_pause           Boolean               @default(false)
  can_renew           Boolean               @default(true)
  quotation_templates quotation_templates[]
  subscriptions       subscriptions[]
}

model product_variants {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id               String                     @db.Uuid
  attribute_name           String                     @db.VarChar(100)
  attribute_value          String                     @db.VarChar(100)
  price_surcharge          Decimal                    @default(0.00) @db.Decimal(12, 2)
  products                 products                   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotation_template_lines quotation_template_lines[]
  subscription_lines       subscription_lines[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String                     @db.VarChar(255)
  product_type             product_type
  sales_price              Decimal                    @db.Decimal(12, 2)
  cost_price               Decimal                    @db.Decimal(12, 2)
  default_tax_id           String?                    @db.Uuid
  notes                    String?
  is_active                Boolean                    @default(true)
  discount_products        discount_products[]
  invoice_lines            invoice_lines[]
  product_variants         product_variants[]
  taxes                    taxes?                     @relation(fields: [default_tax_id], references: [id], onUpdate: NoAction)
  quotation_template_lines quotation_template_lines[]
  subscription_lines       subscription_lines[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quotation_template_lines {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id         String              @db.Uuid
  product_id          String              @db.Uuid
  variant_id          String?             @db.Uuid
  default_quantity    Int                 @default(1)
  products            products            @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  quotation_templates quotation_templates @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants    product_variants?   @relation(fields: [variant_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quotation_templates {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String                     @db.VarChar(255)
  plan_id                  String                     @db.Uuid
  validity_days            Int
  quotation_template_lines quotation_template_lines[]
  plans                    plans                      @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions            subscriptions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subscription_lines {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id  String            @db.Uuid
  product_id       String            @db.Uuid
  variant_id       String?           @db.Uuid
  discount_id      String?           @db.Uuid
  quantity         Int
  unit_price       Decimal           @db.Decimal(12, 2)
  tax_id           String?           @db.Uuid
  tax_amount       Decimal           @default(0.00) @db.Decimal(12, 2)
  line_amount      Decimal           @db.Decimal(12, 2)
  invoice_lines    invoice_lines[]
  discounts        discounts?        @relation(fields: [discount_id], references: [id], onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  subscriptions    subscriptions     @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  taxes            taxes?            @relation(fields: [tax_id], references: [id], onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)
}

model subscriptions {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_number String               @unique @db.VarChar(50)
  customer_id         String               @db.Uuid
  plan_id             String               @db.Uuid
  template_id         String?              @db.Uuid
  discount_id         String?              @db.Uuid
  status              subscription_status  @default(DRAFT)
  start_date          DateTime             @db.Date
  expiry_date         DateTime?            @db.Date
  next_billing_date   DateTime             @db.Date
  payment_terms_days  Int                  @default(0)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  invoices            invoices[]
  subscription_lines  subscription_lines[]
  customer_accounts   customer_accounts    @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  discounts           discounts?           @relation(fields: [discount_id], references: [id], onUpdate: NoAction)
  plans               plans                @relation(fields: [plan_id], references: [id], onUpdate: NoAction)
  quotation_templates quotation_templates? @relation(fields: [template_id], references: [id], onUpdate: NoAction)

  @@index([customer_id, status], map: "idx_sub_customer")
  @@index([status, next_billing_date], map: "idx_sub_status_billing")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model taxes {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @db.VarChar(100)
  rate_percentage    Decimal              @db.Decimal(5, 2)
  is_active          Boolean              @default(true)
  created_by         String               @db.Uuid
  products           products[]
  subscription_lines subscription_lines[]
  users              users                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String             @unique @db.VarChar(255)
  password_hash          String             @db.VarChar(255)
  role                   user_role
  created_by             String?            @db.Uuid
  reset_token            String?            @db.VarChar(255)
  reset_token_expires_at DateTime?          @db.Timestamptz(6)
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  full_name              String?            @db.VarChar(255)
  phone                  String?            @db.VarChar(30)
  job_title              String?            @db.VarChar(100)
  sections               String[]           @default([])
  is_active              Boolean            @default(true)
  customer_accounts      customer_accounts?
  discounts              discounts[]
  payments               payments[]
  taxes                  taxes[]
  users                  users?             @relation("usersTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  other_users            users[]            @relation("usersTousers")
}

enum billing_interval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum discount_target {
  SUBSCRIPTION
  SPECIFIC_PRODUCTS
}

enum discount_type {
  FIXED
  PERCENTAGE
}

enum invoice_status {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum payment_method {
  BANK_TRANSFER
  CREDIT_CARD
  UPI
  CASH
  OTHER
}

enum product_type {
  SOFTWARE
  ADD_ON
  SERVICE
}

enum subscription_status {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum user_role {
  ADMIN
  STAFF
  CUSTOMER
}
